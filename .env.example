# ============================================
# DFS Lab Portfolio Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# See SETUP.md for detailed instructions.
# ============================================

# --- Database ---
# PostgreSQL connection string.
# For Neon: postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# For local: postgresql://user:password@localhost:5432/dfslab
DATABASE_URL="postgresql://user:password@localhost:5432/dfslab"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Your app's base URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- Fork configuration ---
# Rename the deployment without editing source. Defaults reproduce DFS Lab's
# current production behavior exactly, so these are optional.
# NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time —
# changing them requires a redeploy, not just an env edit/restart.
# Organization display name shown in UI copy, page titles, and emails.
# NEXT_PUBLIC_ORG_NAME="DFS Lab"
# Email domain granted admin access via Google OAuth (no leading "@").
# NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN="dfs.vc"
# Path (under /public) to the logo shown in transactional email headers.
# Recommended size ~54x22px — anything else will letterbox in the fixed
# width/height <img> tag.
# IMPORTANT: keep this under /brand/ (or add your path to PUBLIC_PREFIXES in
# src/lib/route-access.ts). Email clients fetch it with no session; any path
# the auth middleware gates will render as a broken image in every email.
# EMAIL_LOGO_PATH="/brand/dfs-logo-primary.png"
# Path (under /public) to the logo shown in the LP portal header. The LP
# layout is a Server Component, so this is read directly with no
# NEXT_PUBLIC_ prefix and no rebuild needed to change it.
# ORG_LOGO_PATH="/brand/dfs-logo-primary.png"
# See also SUPPORT_EMAIL below (already used by the rejection email template
# and the public /investors page).
#
# Fork steps env vars deliberately don't cover (source edits by design):
# - Replace public/brand/* assets and public/favicon.png
# - Replace the CSS theme tokens in src/app/globals.css (colors, fonts)

# --- Google OAuth (for admin login) ---
# Create at: https://console.cloud.google.com/apis/credentials
# Set redirect URI to: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- S3-Compatible Storage ---
# Works with AWS S3, Cloudflare R2, MinIO, etc.
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="dfslab-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email (Resend) ---
# Sign up at: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Molly <noreply@example.com>"
# Email address that receives team notifications (new signups, published updates)
TEAM_EMAIL="team@example.com"
# Contact address shown to investors on the public /investors page, and used
# as the reply-to in the rejection email template
SUPPORT_EMAIL="support@example.com"

# --- Anthropic ---
# For weekly digest drafting. Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Cron ---
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>".
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Google Sheets ingestion (optional — Part 10, WS27) ---
# Skip this entirely if you don't use Sheets: every one of these is checked
# together (sheetsSyncEnabled() in src/lib/sheets.ts), and with any absent,
# the sync cron no-ops, /admin/sync is hidden, the publish-confirm staleness
# banner is hidden, and all deals stay fully editable — zero behavior change.
# Service account email (share the tracker sheet with this address, read-only).
GOOGLE_SA_EMAIL=""
# Service account private key (PEM). Paste with literal \n line breaks, e.g.
# "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n".
GOOGLE_SA_PRIVATE_KEY=""
# The Deals tracker spreadsheet's ID (the long token in its URL between
# /d/ and /edit). The sheet needs a "Stable ID column" (never reused,
# never reordered-away) uniquely identifying each row — see SETUP.md.
SHEETS_SPREADSHEET_ID=""

# --- Dev only ---
# Enables POST /api/dev/bootstrap (creates a dev admin + patches pending users
# with a known approval token). Never set this in a deployed environment.
# ALLOW_DEV_BOOTSTRAP="true"
