generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum UserRole {
  FOUNDER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipRole {
  OWNER
  MEMBER
  VIEWER
}

enum UpdateStatus {
  DRAFT
  SENT
}

enum ProviderType {
  FIRM
  INDIVIDUAL
}

enum ProviderStatus {
  PENDING
  VETTED
  REJECTED
}

// ─── User ─────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String?
  roles         UserRole[] @default([FOUNDER])
  status        UserStatus @default(PENDING)
  approvalToken String?    @unique
  tokenExpiresAt DateTime?
  setupQueueDismissedAt DateTime? // WS48 — admin-hygiene only; never affects login/token/resend eligibility
  googleId      String?    @unique
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships          UserCompanyMembership[]
  updates              Update[]
  documents            Document[]
  comments             Comment[]
  companies            Company[]                @relation("CreatedCompanies")
  shareableLinks       ShareableLink[]          @relation("CreatedLinks")
  receivesDigest       Boolean                  @default(true)
  createdNotes         CompanyNote[]            @relation("CreatedNotes")
  noteRevisions        CompanyNoteRevision[]    @relation("NoteRevisions")
  digestTodos          DigestTodo[]
  submittedProviders   ServiceProvider[]        @relation("SubmittedProviders")
  providerEndorsements ProviderEndorsement[]
  createdTemplates     UpdateTemplate[]         @relation("CreatedTemplates")
  createdFundReports   FundReport[]             @relation("CreatedFundReports")

  @@map("users")
}

// ─── Company ──────────────────────────────────────────────

model Company {
  id           String  @id @default(cuid())
  name         String
  logo         String? // S3 key or URL
  description  String?
  website      String?
  sector       String?
  geography    String?
  fundingStage String?

  aliases               String[]  @default([])
  reminderFrequencyDays Int?      // null = disabled; 7, 14, 30, or 90
  lastReminderSentAt    DateTime? // tracks cooldown between reminders

  stage String @default("ACTIVE") // "DILIGENCE" | "ACTIVE" — Part 16, Q53. Existing rows default to ACTIVE, zero backfill needed.

  createdById String
  createdBy   User   @relation("CreatedCompanies", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       UserCompanyMembership[]
  updates           Update[]
  metricDefinitions MetricDefinition[]
  documents         Document[]
  shareableLinks    ShareableLinkCompany[]
  notes             CompanyNote[]
  metricAlerts      MetricAlert[]
  portfolioCompany  PortfolioCompany?
  diligence         CompanyDiligence?

  @@map("companies")
}

// Part 16, WS38 — one row per due-diligence-stage company (Q53–Q60).
// Deliberately a separate model, not inlined onto Company (JC-DD-C).
model CompanyDiligence {
  id                  String    @id @default(cuid())
  companyId           String    @unique
  isUsIncorporated    Boolean?  // required question, but nullable until answered
  isStellarEcosystem  Boolean   @default(false) // admin-ticked at invite time (Q58) — no Fund linkage
  stellarWhyText      String?   @db.Text // required only when isStellarEcosystem
  stellarTimelineText String?   @db.Text // required only when isStellarEcosystem
  completedAt         DateTime? // recomputed lazily (JC-DD-F) — non-null once the checklist is done
  closedAt            DateTime? // set by the explicit admin promote action (WS41)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_diligence")
}

// ─── User <-> Company ─────────────────────────────────────

model UserCompanyMembership {
  id        String         @id @default(cuid())
  userId    String
  companyId String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_company_memberships")
}

// ─── Update ───────────────────────────────────────────────

model Update {
  id        String       @id @default(cuid())
  companyId String
  createdById String
  period    String       // e.g. "2025-Q1", "2025-01"
  title     String
  body      String       @db.Text // rich text / markdown
  status    UpdateStatus @default(DRAFT)
  sentAt    DateTime?
  scheduledFor DateTime? // null = not scheduled; date-only semantics (publishes at the next daily cron >= this instant)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])
  comments  Comment[]
  documents Document[]
  metricValues MetricValue[]
  shareableLinkSelections ShareableLinkUpdate[]

  @@map("updates")
}

// ─── Metrics ──────────────────────────────────────────────

model MetricDefinition {
  id        String   @id @default(cuid())
  companyId String
  name      String   // e.g. "MRR", "Active Users"
  unit      String?  // e.g. "USD", "count", "%"
  createdAt DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  MetricValue[]
  alerts  MetricAlert[]

  @@unique([companyId, name])
  @@map("metric_definitions")
}

model MetricValue {
  id                 String   @id @default(cuid())
  metricDefinitionId String
  value              Decimal
  date               DateTime // the date this metric is for
  updateId           String?  // optionally linked to an update
  createdAt          DateTime @default(now())

  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  update           Update?          @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@map("metric_values")
}

// ─── Documents ────────────────────────────────────────────

model Document {
  id           String   @id @default(cuid())
  companyId    String
  updateId     String?  // optionally linked to an update
  uploadedById String
  name         String
  s3Key        String
  mimeType     String?
  size         Int?     // bytes
  isInternal   Boolean   @default(false) // admin-only docs
  docType      String?   // "pitch_deck" | "financials" | "legal" | "product" | "other"
  archivedAt   DateTime? // null = active, set = archived
  createdAt    DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  update     Update? @relation(fields: [updateId], references: [id], onDelete: SetNull)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
  @@map("documents")
}

// ─── Comments ─────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  updateId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── Sectors ──────────────────────────────────────────────

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("sectors")
}

// ─── Shareable Investor Links ─────────────────────────────

model ShareableLink {
  id          String    @id @default(cuid())
  token       String    @unique
  label       String?
  createdById String
  periodStart DateTime? // null for links using explicit update selection
  periodEnd   DateTime? // null for links using explicit update selection
  expiresAt   DateTime? // null = never expires
  metricScope String    @default("ALL_TIME") // "ALL_TIME" | "PERIOD" — ALL_TIME = pre-existing behavior
  createdAt   DateTime  @default(now())

  createdBy       User                   @relation("CreatedLinks", fields: [createdById], references: [id])
  companies       ShareableLinkCompany[]
  views           ShareableLinkView[]
  selectedUpdates ShareableLinkUpdate[]

  @@map("shareable_links")
}

model ShareableLinkUpdate {
  id       String @id @default(cuid())
  linkId   String
  updateId String

  link   ShareableLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  update Update        @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([linkId, updateId])
  @@map("shareable_link_updates")
}

model ShareableLinkCompany {
  id        String @id @default(cuid())
  linkId    String
  companyId String

  link    ShareableLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([linkId, companyId])
  @@map("shareable_link_companies")
}

model ShareableLinkView {
  id       String   @id @default(cuid())
  linkId   String
  email    String
  viewedAt DateTime @default(now())

  link ShareableLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("shareable_link_views")
}

// ─── Company Notes ────────────────────────────────────────

model CompanyNote {
  id            String   @id @default(cuid())
  companyId     String
  createdById   String
  title         String
  body          String   @db.Text
  occurredAt    DateTime
  transcriptUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("CreatedNotes", fields: [createdById], references: [id])
  revisions CompanyNoteRevision[]
  @@map("company_notes")
}

model CompanyNoteRevision {
  id            String   @id @default(cuid())
  noteId        String
  title         String
  body          String   @db.Text
  occurredAt    DateTime
  transcriptUrl String?
  editedById    String
  createdAt     DateTime @default(now())

  note     CompanyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editedBy User        @relation("NoteRevisions", fields: [editedById], references: [id])

  @@map("company_note_revisions")
}

// ─── Weekly Digest ────────────────────────────────────────

model WeeklyDigest {
  id        String       @id
  weekOf    DateTime
  title     String
  sections  Json         // DigestSection[]
  sentAt    DateTime?
  createdAt DateTime     @default(now())
  todos     DigestTodo[]

  @@map("weekly_digests")
}

model DigestTodo {
  id         String        @id
  digestId   String
  digest     WeeklyDigest  @relation(fields: [digestId], references: [id], onDelete: Cascade)
  text       String
  assigneeId String?
  assignee   User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  completed  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@map("digest_todos")
}

// ─── Service Providers ────────────────────────────────────

model ServiceCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  providers ServiceProvider[]

  @@map("service_categories")
}

model ServiceProvider {
  id            String         @id @default(cuid())
  type          ProviderType   @default(FIRM)
  name          String
  website       String?
  linkedin      String?
  categoryId    String
  description   String?        @db.Text
  contactEmail  String?
  country       String?
  city          String?
  status        ProviderStatus @default(PENDING)
  submittedById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category     ServiceCategory      @relation(fields: [categoryId], references: [id])
  submittedBy  User?                @relation("SubmittedProviders", fields: [submittedById], references: [id])
  endorsements ProviderEndorsement[]

  @@unique([name, categoryId])
  @@map("service_providers")
}

model ProviderEndorsement {
  id         String   @id @default(cuid())
  providerId String
  userId     String
  note       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@unique([providerId, userId])
  @@map("provider_endorsements")
}

model DigestExtraRecipient {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("digest_extra_recipients")
}

// ─── Rate Limiting ────────────────────────────────────────

model RateLimitCounter {
  id          String   @id @default(cuid())
  key         String   // e.g. "signup:203.0.113.7"
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@map("rate_limit_counters")
}

// ─── Audit Log ────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String   // e.g. "USER_APPROVED"
  targetType String?  // e.g. "User", "Company"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Update Templates ─────────────────────────────────────

model UpdateTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?   // one-line hint shown to founders
  body        String    @db.Text // rich text HTML, same format as Update.body
  createdById String
  archivedAt  DateTime? // soft delete — founders only see active templates
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation("CreatedTemplates", fields: [createdById], references: [id])

  @@map("update_templates")
}

// ─── Metric Alerts ────────────────────────────────────────

model MetricAlert {
  id                 String    @id @default(cuid())
  companyId          String
  rule               String    // "METRIC_CHANGE" | "NO_METRICS_IN_UPDATES"
  metricDefinitionId String?   // set for METRIC_CHANGE
  message            String    // e.g. "MRR changed −34% (12,000 → 7,900)"
  dedupeKey          String    @unique // see evaluator — prevents refiring on unchanged data
  metadata           Json?     // { previousValue, latestValue, changePct, previousDate, latestDate }
  firedAt            DateTime  @default(now())
  resolvedAt         DateTime? // set when an admin dismisses
  resolvedById       String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, firedAt])
  @@map("metric_alerts")
}

// ─── LP Fund-Report Portal ────────────────────────────────

model Fund {
  id            String    @id @default(cuid())
  slug          String    @unique // import key, e.g. "FUND1" — never shown to LPs
  name          String    // display name, editable, e.g. "FUND1" or "DFS Lab SPV I"
  groupLabel    String?   // e.g. "African Multi-Asset Cohort Funds" (Deals sheet row 3)
  firstDealDate DateTime?
  aumUsd        Decimal?
  sortOrder     Int       @default(0)

  // Part 15, WS37.1 — manual admin-entered performance overrides (Q46–Q52).
  // Generic per-fund (Q47), independently nullable so an admin can fill
  // these in incrementally; populated for CAF1 only today. No "as of"/
  // provenance column (Q51 — no separate staleness note; FUND_UPDATED
  // audit rows already timestamp every change if that history is ever
  // needed).
  grossMoicOverride Decimal?
  netTvpiOverride   Decimal?
  netDpiOverride    Decimal?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deals     Deal[]
  lps       LpFundMembership[]
  reports   FundReport[]
  cashflows FundCashflow[]
  reportSnapshots FundReportFundSnapshot[]

  @@map("funds")
}

model PortfolioCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String?
  companyId String?  @unique // optional link to an operational Molly Company (Q14)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals    Deal[]
  mentions FundReportMention[]
  rounds    FinancingRound[]
  marks     ValuationMark[]
  cashflows FundCashflow[]

  @@map("portfolio_companies")
}

model Deal {
  id                 String    @id @default(cuid())
  fundId             String
  portfolioCompanyId String
  investmentType     String    // "INITIAL" | "FOLLOW_ON"
  dealDate           DateTime
  country            String?
  amountUsd          Decimal
  instrument         String?   // free text — source data has typos/variants (F17)
  entryValuation     Decimal?  // valuation/cap (post) at investment
  currentValuation   Decimal?  // admin-maintained after import; 0 = written off
  valuationAsOf      DateTime? // when currentValuation was last set (import date initially, F17.4)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Part 10 / WS24 (additive): ledger pointers. roundId links this deal to
  // the FinancingRound it was part of; convertedInRoundId records which
  // PRICED round a SAFE deal converted in (Q24). ownershipPct is the fund's
  // ownership after this deal's round, optional-when-known (Q24) — never
  // required, never read by any existing renderer (JC16).
  roundId            String?
  convertedInRoundId String?
  ownershipPct       Decimal?

  // Part 10 / WS27 (additive): the Deals-sheet row identity, once synced.
  // Set only when a sheet sync has matched this deal to a "Stable ID
  // column" value (JC19 — sync never deletes/reassigns this). Non-null
  // makes sheet-owned fields read-only in admin CRUD while sync is
  // enabled (Q22-B/Q26, WS27.5).
  sheetRowId String? @unique

  fund             Fund             @relation(fields: [fundId], references: [id], onDelete: Cascade)
  portfolioCompany PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)
  round            FinancingRound?  @relation("RoundDeals", fields: [roundId], references: [id], onDelete: SetNull)
  convertedInRound FinancingRound?  @relation("ConvertedDeals", fields: [convertedInRoundId], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([portfolioCompanyId])
  @@map("deals")
}

// ─── Portfolio Ledger (Part 10, WS24) ─────────────────────
// Additive: financing rounds, valuation-mark history, and fund cashflows.
// None of this is read by any existing renderer — `Deal.currentValuation`/
// `valuationAsOf` remain the authoritative render path for frozen report
// snapshots and the LP surface (JC16). No position table (JC18) — fund/
// company positions are a computed view, not persisted.

model FinancingRound {
  id                 String   @id @default(cuid())
  portfolioCompanyId String
  label              String?  // free text: "Seed", "Series A", "SAFE (2024)" — mirrors Deal.instrument's free-text convention (F17)
  kind               String   @default("UNKNOWN") // "PRICED" | "SAFE" | "CONVERSION" | "OTHER" | "UNKNOWN"
  roundDate          DateTime
  raisedUsd          Decimal? // FULL round size, all investors — optional-when-known (Q24)
  preMoneyUsd        Decimal?
  postMoneyUsd       Decimal? // valuation or cap (post)
  source             String   @default("MANUAL") // "MANUAL" | "BACKFILL" | "SHEET"
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  portfolioCompany PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)
  deals            Deal[]           @relation("RoundDeals")
  conversions      Deal[]           @relation("ConvertedDeals")

  @@index([portfolioCompanyId, roundDate])
  @@map("financing_rounds")
}

model ValuationMark {
  id                 String   @id @default(cuid())
  portfolioCompanyId String
  valuationUsd       Decimal  // company valuation; 0 = written off (house convention)
  asOf               DateTime
  source             String   @default("MANUAL") // "MANUAL" | "BACKFILL" | "SHEET"
  notes              String?
  createdAt          DateTime @default(now())

  portfolioCompany PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@index([portfolioCompanyId, asOf])
  @@map("valuation_marks")
}

model FundCashflow {
  id                 String   @id @default(cuid())
  fundId             String
  portfolioCompanyId String?  // set for company-attributed distributions/exits
  kind               String   // "CAPITAL_CALL" | "DISTRIBUTION" | "FEE" | "OTHER"
  date               DateTime
  amountUsd          Decimal  // always positive; direction is implied by kind
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  fund             Fund              @relation(fields: [fundId], references: [id], onDelete: Cascade)
  portfolioCompany PortfolioCompany? @relation(fields: [portfolioCompanyId], references: [id], onDelete: SetNull)

  @@index([fundId, date])
  @@map("fund_cashflows")
}

// Part 10, WS27: one row per Google Sheets sync attempt (cron or manual,
// including dry-run previews). `summary` carries the diff (creates/
// updates/newCompanies/errors) — real valuations, so admin-gated reads
// only, never logged to the console where avoidable (ground rule 1).
model SheetSyncRun {
  id         String    @id @default(cuid())
  trigger    String    // "CRON" | "MANUAL" | "DRY_RUN"
  status     String    // "SUCCESS" | "FAILED"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
  error      String?

  @@index([startedAt])
  @@map("sheet_sync_runs")
}

model LimitedPartner {
  id        String   @id @default(cuid())
  email     String   @unique // stored lowercased/trimmed
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funds    LpFundMembership[]
  sessions LpSession[]
  otpCodes LpOtpCode[]

  @@map("limited_partners")
}

model LpFundMembership {
  id        String   @id @default(cuid())
  lpId      String
  fundId    String
  createdAt DateTime @default(now())

  lp   LimitedPartner @relation(fields: [lpId], references: [id], onDelete: Cascade)
  fund Fund           @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([lpId, fundId])
  @@map("lp_fund_memberships")
}

model LpOtpCode {
  id         String    @id @default(cuid())
  lpId       String
  codeHash   String    // sha256 hex of the 6-digit code — never store the code
  expiresAt  DateTime  // request time + 10 minutes
  attempts   Int       @default(0) // fail-closed cap of 5 (rate limiter fails open — this doesn't)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  lp LimitedPartner @relation(fields: [lpId], references: [id], onDelete: Cascade)

  @@index([lpId, createdAt])
  @@map("lp_otp_codes")
}

model LpSession {
  id         String   @id @default(cuid())
  token      String   @unique // crypto.randomBytes(32).toString("hex")
  lpId       String
  expiresAt  DateTime // verify time + 30 days, fixed
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  lp LimitedPartner @relation(fields: [lpId], references: [id], onDelete: Cascade)

  @@index([lpId])
  @@map("lp_sessions")
}

model FundReport {
  id          String    @id @default(cuid())
  fundId      String
  title       String    // e.g. "FUND1 — H1 2026 Report"
  periodLabel String?   // e.g. "H1 2026"
  body        String    @db.Text // TipTap HTML incl. mention spans (data-portco)
  status      String    @default("DRAFT") // "DRAFT" | "PUBLISHED"
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fund      Fund                @relation(fields: [fundId], references: [id])
  createdBy User                @relation("CreatedFundReports", fields: [createdById], references: [id])
  mentions  FundReportMention[]
  fundSnapshot FundReportFundSnapshot?

  @@index([fundId, status])
  @@map("fund_reports")
}

model FundReportMention {
  id                 String   @id @default(cuid())
  reportId           String
  portfolioCompanyId String
  companyName        String   // display name frozen at publish
  snapshot           Json     // frozen at publish — shape in WS17.2
  createdAt          DateTime @default(now())

  report           FundReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  portfolioCompany PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@unique([reportId, portfolioCompanyId])
  @@map("fund_report_mentions")
}

// Part 14, WS33.1 — frozen fund-level performance snapshot, one per report
// (reports are single-fund scoped — Q43). Second, independent freeze living
// alongside FundReportMention, same delete-and-recreate-on-publish semantics
// (Q44-A), never a modification of the mention freeze path.
model FundReportFundSnapshot {
  id        String   @id @default(cuid())
  reportId  String   @unique // one snapshot per report — reports are single-fund scoped (Q43/finding #4)
  fundId    String
  fundName  String   // display name frozen at publish — never fund.slug (finding #3 / ground rule 2)
  snapshot  Json     // shape: FundSnapshotPayload, WS33.3
  createdAt DateTime @default(now())

  report FundReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fund   Fund       @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@map("fund_report_fund_snapshots")
}
